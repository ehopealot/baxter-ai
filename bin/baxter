#!/bin/sh
# baxter -- ergonomic front-end for operating a Baxter deployment.
#
# This is a THIN wrapper, not a reimplementation: lifecycle commands delegate to
# the repo Makefile (which owns image-building, the arch-specific codapi binary,
# and the durable network/volume), and only the per-service operations the
# Makefile doesn't parameterize (logs/status/restart of ONE service) call docker
# directly. Keep the Makefile as the source of truth for dev/build; use `baxter`
# to run the fleet.
#
# Installed by install.sh as a SYMLINK onto PATH, so `git pull` updates it with
# no reinstall. It resolves its own real path below to find the repo, so it works
# from any directory.
set -eu

# --- locate the repo (follow symlinks to this script, then take its parent's parent) ---
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
BAXTER_HOME=$(CDPATH= cd -- "$(dirname "$self")/.." && pwd)
# Matches the Makefile's PROJECT := $(notdir $(CURDIR)) -- the container prefix.
PROJECT=$(basename "$BAXTER_HOME")

mk() { make -C "$BAXTER_HOME" "$@"; }

# Friendly service name -> container name. `mail` is the poller (container -run),
# `codapi` is the sandbox (-codapi-svc); the rest match 1:1.
container_for() {
  case $1 in
    discord)   echo "${PROJECT}-discord" ;;
    heartbeat) echo "${PROJECT}-heartbeat" ;;
    mail)      echo "${PROJECT}-run" ;;
    voice)     echo "${PROJECT}-voice" ;;
    codapi)    echo "${PROJECT}-codapi-svc" ;;
    *)         return 1 ;;
  esac
}

fleet_names() { docker ps --filter "name=^${PROJECT}-" --format '{{.Names}}'; }

usage() {
  cat <<EOF
baxter -- operate the Baxter fleet (repo: $BAXTER_HOME)

Lifecycle:
  baxter up [mail|all]     start the fleet (default: discord+heartbeat+codapi;
                           'mail' adds the poller; 'all' adds mail + voice)
  baxter down              stop + remove the fleet (data/volume left intact)
  baxter restart [svc]     restart the whole fleet, or one service (no rebuild)
  baxter update [main]     update to the latest RELEASE + rebuild + restart (run on
                           the box); 'main' tracks bleeding-edge main instead

Observe:
  baxter status            show fleet container status
  baxter logs [svc]        follow logs -- whole fleet, or one service
                           (svc: discord|heartbeat|mail|voice|codapi)

Surfaces / setup:
  baxter shell [-v] [<box>] open Baxter's interactive terminal (chat + /tools); -v
                           shows tool/debug output; a <box> arg / BOX=<box> runs it over SSH
  baxter voice             start the opt-in voice bot
  baxter inbox             provision the AgentMail inbox (one-time)

Maintenance:
  baxter build             rebuild the app image
  baxter backup            snapshot Baxter's full state
  baxter restore <file>    restore a state snapshot (path relative to repo root)
  baxter harness [...]     show model, or switch:
                             baxter harness claude
                             baxter harness openrouter <model>
                             baxter harness openai <model> [base-url]   (OpenAI-style: local OR remote)
                             baxter harness custom <anthropic|gemini> <model> [base-url]
  baxter set-key <t> <k>   set an API key in app/.env (t: openrouter|openai|anthropic|
                             custom|agentmail|discord; the value is not echoed)

  baxter help              this help
EOF
}

bad_service() {
  echo "unknown service '$1' (use: discord | heartbeat | mail | voice | codapi)" >&2
  exit 1
}

cmd=${1:-help}
[ $# -gt 0 ] && shift || true

case $cmd in
  up)
    case ${1:-} in
      "")   mk run ;;
      mail) mk run-mail ;;
      all)  mk run-mail && mk voice ;;
      *)    echo "usage: baxter up [mail|all]" >&2; exit 1 ;;
    esac
    ;;
  down)    mk stop ;;
  restart)
    if [ $# -gt 0 ]; then
      c=$(container_for "$1") || bad_service "$1"
      docker restart "$c"
    else
      names=$(fleet_names)
      [ -n "$names" ] || { echo "no running ${PROJECT}- containers"; exit 0; }
      # shellcheck disable=SC2086
      docker restart $names
    fi
    ;;
  update)
    # baxter update        -> update to the latest RELEASE tag + rebuild + restart
    # baxter update main    -> return to bleeding-edge main (dev boxes)
    case "${1:-}" in
      ""|release) mk deploy-release ;;
      main)       mk deploy-main ;;
      *) echo "usage: baxter update [main]   (default: latest release; 'main' = bleeding edge)" >&2; exit 1 ;;
    esac
    ;;
  status)
    docker ps --filter "name=^${PROJECT}-" \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
    ;;
  logs)
    if [ $# -gt 0 ]; then
      c=$(container_for "$1") || bad_service "$1"
      docker logs -f --tail 100 "$c"
    else
      mk logs
    fi
    ;;
  voice)   mk voice ;;
  inbox)   mk inbox ;;
  build)   mk build-app ;;
  shell)
    # baxter shell [-v] [<box>] -> Baxter's interactive terminal (the TUI). -v shows
    # tool/debug output (default is a clean conversation). BOX selects the run
    # ENVIRONMENT: absent -> local (make tui); a positional or $BOX -> the same TUI on
    # that box over SSH (which re-invokes `baxter shell` there, i.e. locally).
    verbose=""
    box=""
    for a in "$@"; do
      case "$a" in
        -v|--verbose) verbose="-v" ;;
        *) [ -z "$box" ] && box="$a" ;;
      esac
    done
    box=${box:-${BOX:-}}
    if [ -n "$box" ]; then
      remote=${REMOTE_DIR:-/opt/baxter}
      exec ssh -t "$box" "cd '$remote' && ./bin/baxter shell $verbose"
    else
      mk tui TUI_FLAGS="$verbose"
    fi
    ;;
  backup)  mk backup ;;
  restore)
    [ $# -gt 0 ] || { echo "usage: baxter restore <file>   (path relative to repo root, see 'ls $BAXTER_HOME/backups')" >&2; exit 1; }
    mk restore RESTORE_FILE="$1"
    ;;
  harness)
    case ${1:-} in
      "")         mk harness ;;
      claude)     mk use-claude ;;
      openrouter) [ $# -ge 2 ] || { echo "usage: baxter harness openrouter <model>" >&2; exit 1; }
                  mk use-openrouter MODEL="$2" ;;
      openai|local) [ $# -ge 2 ] || { echo "usage: baxter harness openai <model> [base-url]" >&2; exit 1; }   # `local` = back-compat alias
                  if [ $# -ge 3 ]; then mk use-openai MODEL="$2" BASE_URL="$3"; else mk use-openai MODEL="$2"; fi ;;
      custom)     [ $# -ge 3 ] || { echo "usage: baxter harness custom <anthropic|gemini> <model> [base-url]" >&2; exit 1; }
                  if [ $# -ge 4 ]; then mk use-custom DIALECT="$2" MODEL="$3" BASE_URL="$4"; else mk use-custom DIALECT="$2" MODEL="$3"; fi ;;
      *)          echo "usage: baxter harness [claude | openrouter <model> | openai <model> [base-url] | custom <dialect> <model> [base-url]]" >&2; exit 1 ;;
    esac
    ;;
  set-key)
    # baxter set-key <type> <key> -> write an API key into app/.env (0600, gitignored)
    # without echoing it. (The key is a command arg, so it lands in shell history --
    # acceptable for a convenience setter; clear it there if that matters to you.)
    [ $# -ge 2 ] || { echo "usage: baxter set-key <openrouter|openai|anthropic|custom|agentmail|discord> <key>" >&2; exit 1; }
    mk set-key TYPE="$1" KEY="$2" ;;
  help|-h|--help) usage ;;
  *) echo "unknown command '$cmd'" >&2; echo >&2; usage >&2; exit 1 ;;
esac
