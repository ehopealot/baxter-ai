.env
*~
\#*\#
.\#*
node_modules/
.DS_Store
backups/
.models/   # leftover from the MLX prototype; Ollama now uses ~/.ollama (safe to rm)

# codapi wrapper copies (build artifacts; source is app/sandboxes/emit-artifacts.sh)
app/sandboxes/python/emit-artifacts.sh
app/sandboxes/node/emit-artifacts.sh

# Python bytecode
__pycache__/
*.pyc

# `impeccable` edit-hook -- a locally-installed dev tool, not required repo-wide
# (its skill implementation isn't vendored here, so committing the config alone
# would hand everyone a broken postToolUse hook).
.github/hooks/impeccable.json
.github/skills/impeccable/
