# Copy to .env and fill in real values. .env is gitignored and
# dockerignored; only .env.example is meant to be committed.
# Loaded into the container automatically via `--env-file app/.env`.

# AgentMail (https://agentmail.to) -- the email provider for Baxter's inbox.
# One API key; no OAuth, no token to renew. Get a key from the AgentMail
# dashboard, set it here, then run `make inbox` once to create-or-show Baxter's
# inbox -- it prints the two values below to paste in.
AGENTMAIL_API_KEY=

# Baxter's inbox, from `make inbox`. BAXTER_EMAIL is the address this agent reads
# and sends from; AGENTMAIL_INBOX_ID is the inbox the API calls target (on the
# default @agentmail.to domain the address doubles as the id).
AGENTMAIL_INBOX_ID=
BAXTER_EMAIL=

# Optional: the From display NAME on Baxter's outgoing mail (AgentMail stamps it;
# `make inbox` applies it to the inbox, defaulting to "Baxter B." if unset). Kept
# separate from PERSONA_NAME so email can be shorter than the full persona.
# MAIL_FROM_NAME=Baxter B.

# Your own email -- where operational notices go, and ALWAYS a permitted `send`
# recipient (unioned into ALLOWED_RECIPIENTS below). Deliberately separate from
# BAXTER_EMAIL: nobody reads the agent's own inbox, so a notice sent there would
# go unseen. If ALLOWED_RECIPIENTS is empty, this is the ONLY address `send` can
# reach -- i.e. the historical operator-only behavior.
# NOTE (if the `home` surface is enabled): this SEEDS the tenant's protected
# member -- unioned into recipients, marked protected, and non-removable from
# the home.<domain> Settings page. After first run it's the DO's stored
# membership, not this var, that governs.
OPERATOR_EMAIL=

# The operator's own phone number (E.164, e.g. +15551234567, or a plain 10-digit
# US number -- normalized the same way everywhere it's hashed). Optional; mirrors
# OPERATOR_EMAIL but for the `sms` surface (below): baxctl provisioning
# (`baxctl home <id>`, also run by add/import) writes hash(OPERATOR_PHONE)->this
# tenant to the shared directory KV, so an inbound text from this number resolves
# here. Family-member phones are NOT set here -- they're added live through the
# home admin UI's Settings page, same as family-member emails.
OPERATOR_PHONE=

# Comma-separated list of sender addresses allowed to TRIGGER the agent (receive).
# Fails closed: if this is unset or empty, no inbound mail is processed at
# all, from anyone -- including the dedicated account itself, which is
# always excluded regardless of this list (loop prevention).
# NOTE (if the `home` surface is enabled): this and ALLOWED_RECIPIENTS below only
# SEED the tenant's allow-list on first run (see docs/architecture/home.md). After
# that, the live source of truth is the control-plane Durable Object, mirrored
# locally to allowlist.json (the fixed path scripts/paths.ts exports as
# ALLOWLIST_PATH -- not an env var you can set) and maintained from the
# home.<domain> Settings page (add/remove a member -- pushed down the link live,
# no restart needed). Editing this var after first run has no effect WHILE
# allowlist.json is present and parses cleanly -- but it remains the fail-closed
# fallback if that file goes missing or corrupt, so prune revoked addresses
# from it too (a stale seed here silently re-grants access when the fallback
# fires).
ALLOWED_SENDERS=

# Comma-separated list of addresses Baxter's `send` may reach (send). OPERATOR_EMAIL
# is always included implicitly, so leaving this empty preserves operator-only send.
# Sourced ONLY from the environment (never a message/argument), so it stays outside
# the prompt barrier: a run picks WHICH allowed address to send to, but can never
# reach one that isn't listed here (or OPERATOR_EMAIL). `reply` is unaffected -- it
# only ever goes back to an already-allowlisted thread. The symmetric counterpart of
# ALLOWED_SENDERS: senders trigger the agent, recipients receive its `send`s.
# NOTE (if the `home` surface is enabled): SEED-only, same as ALLOWED_SENDERS above --
# see that note.
ALLOWED_RECIPIENTS=

# Persona name used in replies and when registering for accounts.
PERSONA_NAME=Baxter

# Model for the Claude Code harness (only when BAXTER_HARNESS=claude, below). sonnet
# balances cost against Baxter's agentic browsing/scripting; haiku is cheaper/faster
# but riskier on multi-step tasks; opus is the most capable/expensive.
#BAXTER_MODEL=sonnet

# Which agent harness runs each message: "openrouter" (via OpenRouter -- the DEFAULT
# here), "claude" (Claude Code), "openai" (ANY OpenAI-compatible chat/completions
# endpoint -- a local model OR a hosted/remote one like OpenAI; `local` is a deprecated
# alias for it), or "custom" (any keyed LLM API via a pluggable wire dialect -- Anthropic
# Messages or Gemini; see the CUSTOM_API_* block below). Any OTHER value crashes the daemon
# at startup (fail-fast on a typo, rather than silently dropping every message). (If unset/
# empty the code falls back to openrouter -- the SAME safe default this template sets
# explicitly; claude is opt-in because its native Read isn't cwd-confined -- see README step 2.)
BAXTER_HARNESS=openrouter

# OpenRouter harness (the default). Runs Baxter against any tool-calling model on
# OpenRouter, reusing the same skills/CLIs/prompts. Get a key at openrouter.ai -> Keys
# (sk-or-...). Leave it EMPTY and the daemon fails fast with a clear "not set" message.
# (No inline comment on the model line: `docker run --env-file` -- used by baxter shell/
# make mail/discord -- does NOT strip ` # ...`, so it would become part of the value.)
OPENROUTER_API_KEY=
# Must support tool calling. Any tool-calling model on OpenRouter works; cheaper
# models are fine for most of Baxter's scoped-tool work.
OPENROUTER_MODEL=openai/gpt-4o
#OPENROUTER_MAX_STEPS=40                # optional: caps the tool-loop iterations per run
#OPENROUTER_MAX_TOKENS=0            # optional context guard: stop the run once cumulative
                                    #   token usage exceeds this (0 = off). The SDK owns the
                                    #   message array so we can't trim it, only halt early. It
                                    #   sums BILLED tokens across steps (each step re-bills the
                                    #   whole history), so cumulative usage crosses N well before
                                    #   the live context does -- set this to a few MULTIPLES of
                                    #   your model's window, not the window itself.
#OPENROUTER_CONTEXT_RETRY_MAX=2     # if the model's window IS exceeded, truncate the oldest
                                    #   tool outputs in the saved state and resume, up to N times,
                                    #   before ending the run gracefully.
#OPENROUTER_MULTIMODAL_MODEL=google/gemini-2.5-flash   # optional: when a Discord post OR an inbound
                                    #   email carries media (image/video/audio/PDF -- email is
                                    #   image/audio/PDF, video is out for email v1), route THAT run
                                    #   to this multimodal model with the attachment(s) attached to
                                    #   the prompt; other runs use OPENROUTER_MODEL. Empty/unset = off.
#OPENROUTER_MEDIA_AUDIO_MAX_BYTES=8388608   # optional: Discord audio is sent as base64 (no URL
                                    #   passthrough), so cap it -- attachments over this are skipped (8 MiB).
#OPENROUTER_MEDIA_MAIL_MAX_BYTES=8388608    # optional: ALL email media is base64 (image/PDF/audio),
                                    #   so this caps every email attachment (default 8 MiB).
#MAIL_MEDIA_MAX_ATTACHMENTS=4       # optional: max attachments forwarded from one email (default 4).

# OpenAI-style harness (only used when BAXTER_HARNESS=openai; `local` is a deprecated
# alias). Drives ANY OpenAI-compatible chat/completions endpoint -- a local model via
# Ollama (default), LM Studio, llama.cpp, vLLM, OR a hosted/remote one (OpenAI, or any
# compatible host). The model MUST support tool calling.
#
# FOOTGUN: never put an inline `# comment` after a value below. `docker run --env-file`
# (used by baxter shell / make mail|discord) does NOT strip it, so the comment becomes
# part of the value -- the usual cause of "my model / base-url is ignored". Comments go on
# their OWN lines, like these.
#
# Base URL -- default is Ollama's; set a remote one to point at OpenAI etc.:
#OPENAI_BASE_URL=http://localhost:11434/v1
# The model id/tag your endpoint serves (an Ollama tag locally, or e.g. gpt-4o on OpenAI):
#OPENAI_MODEL=qwen3
# API key -- REQUIRED for a remote/hosted endpoint (local servers usually ignore it).
# Easiest to set with:  baxter set-key openai <key>
#OPENAI_API_KEY=
# Caps the tool-loop iterations per run:
#OPENAI_MAX_STEPS=40
# Context guard -- before each call, stub the oldest tool results to keep history under
# this (~chars/4); set near your model's context window (num_ctx), lower for small models, 0=off:
#OPENAI_CONTEXT_MAX_TOKENS=24000
# If the window is still exceeded, trim harder (halve) and retry N times, then stop:
#OPENAI_CONTEXT_RETRY_MAX=2
# Optional reasoning control for thinking-capable models: "none" disables thinking on
# Ollama's /v1 endpoint (which ignores the native `think` field); low/medium/high keep it.
# Leave unset for real OpenAI/OpenRouter (they reject "none") -- the field is then omitted.
#OPENAI_REASONING_EFFORT=none

# Custom-API harness (only used when BAXTER_HARNESS=custom). Drives any keyed LLM API
# whose NATIVE wire format isn't OpenAI chat/completions -- pick a DIALECT and point it at
# the provider. Ships two dialects; OpenAI-compatible endpoints use the `openai` harness.
# The model MUST support tool calling. (Same footgun as the openai block above: keep
# comments on their OWN lines -- an inline `# ...` becomes part of the value.)
#
# Dialect -- anthropic (Claude Messages API) | gemini (Google generateContent):
#CUSTOM_API_DIALECT=anthropic
# The provider's model id (gemini e.g. gemini-2.5-flash):
#CUSTOM_API_MODEL=claude-sonnet-5
# Provider API key (anthropic x-api-key / Google AI key) -- or:  baxter set-key custom <key>
#CUSTOM_API_KEY=
# Optional: override the dialect default base (api.anthropic.com / generativelanguage.
# googleapis.com) to target a proxy/self-host:
#CUSTOM_API_BASE_URL=
# Max tokens the model may generate per turn:
#CUSTOM_API_MAX_OUTPUT_TOKENS=8192
# Caps the tool-loop iterations per run:
#CUSTOM_API_MAX_STEPS=40
# Context guard (~chars/4): stub the oldest tool results/args to keep the transcript under
# this. 0 = off (default; no single window across dialects, daemons already bound history):
#CUSTOM_API_CONTEXT_MAX_TOKENS=0
# If the window is still exceeded, trim harder (halve) and retry N times:
#CUSTOM_API_CONTEXT_RETRY_MAX=2

# How often poll.ts checks the AgentMail inbox for new mail.
POLL_INTERVAL_SECONDS=60

# Operational safety caps, not permission guardrails -- keep a bad prompt
# or a broken thread from spiraling into a flood of emails.
MAX_EMAILS_PER_CYCLE=5
MAX_SENDS_PER_DAY=500

# --- Per-tenant model-usage metering (credits) ---
# Every run's real USD spend (OpenRouter/claude) is recorded to a per-tenant
# ledger regardless of these knobs; see `usage-cli show` / bare `/usage`.
# Per-PERIOD USD budget (the period is set below; monthly by default -- so with
# BAXTER_CREDIT_PERIOD=day this same figure is a DAILY budget). Unset/0 =
# tracking-only. Over budget the run STILL proceeds (fail-open) + a loud log line.
#BAXTER_CREDIT_BUDGET_USD=15
# Reset/rotation period: month (default) or day. Effectively set-once per deploy
# (the ledger filename scheme differs, so flipping mid-period resets visible spend).
#BAXTER_CREDIT_PERIOD=month
# 1 = when over budget, set BAXTER_CREDITS_LOW=1 in the run so Baxter can add a
# soft "low on credits" note. Default (unset) = alert-only, no user-visible change.
#BAXTER_CREDITS_SOFT_NOTE=0

# --- Discord bot (optional; unset DISCORD_BOT_TOKEN disables it entirely) ---
# Bot token from the Discord Developer Portal (Bot tab). The Message Content
# privileged intent MUST be enabled there. The daemon writes it to a 0600 file
# at startup and STRIPS it from the spawned run's env, and discord-cli reads it
# from that file -- so the per-message claude run never carries the token in its
# environment (mirrors how mail.ts reads agentmail-key.json).
# Invite the bot with every permission EXCEPT: Create Invite, Kick/Ban Members,
# Manage Roles, Manage Channels, Manage Server, Administrator, Moderate Members.
DISCORD_BOT_TOKEN=
# Daily Discord send cap (flood guard), analogous to MAX_SENDS_PER_DAY.
DISCORD_MAX_SENDS_PER_DAY=2500
# Recent scrollback fed to each run's prompt. Kept small -- most triggers only
# need recent context and the run can pull more via `discord-cli fetch-history`.
# Bump it for busy channels; Discord returns <=100 per request (values >100 are
# clamped, no pagination). Must be >= 1 -- 0 is rejected at startup.
DISCORD_HISTORY_LIMIT=25
# Max media attachments from a trigger post forwarded to the multimodal model
# (only when OPENROUTER_MULTIMODAL_MODEL is set). Also caps the coalesce carry-forward.
DISCORD_MEDIA_MAX_ATTACHMENTS=4
# Per-channel coalescing window (ms): rapid messages become one run.
DISCORD_DEBOUNCE_MS=4000
# Global cap on simultaneous claude runs across channels.
DISCORD_MAX_CONCURRENT_RUNS=5
# Per-channel hourly run budget -- the hard terminator for a bot-to-bot loop
# (which runs serially, so the concurrency caps above never bound it). Once a
# channel hits this many runs in an hour, further triggers there are dropped
# until the window rolls off. 0 = unlimited (falls back to the daily send cap).
DISCORD_MAX_RUNS_PER_CHANNEL_PER_HOUR=150
# Optional comma-separated guild-id allowlist. Empty = any invited server.
DISCORD_GUILD_ALLOWLIST=

# --- Log mirroring to Discord (optional) ---
# Mirror each daemon's stdout/stderr log to its own Discord channel via a webhook
# (best-effort, batched; the full log always stays in `docker logs`). Each fleet
# daemon picks the matching var below by its DISCORD_LOG_SURFACE (set per service in
# compose.yaml), so create four channels (e.g. #baxter-logs-discord / -voice /
# -mail / -heartbeat) and, in each, Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy URL, and paste it here. Leave any blank to not mirror that
# surface. The webhook URL is a write-only post token (no bot token needed).
DISCORD_LOG_WEBHOOK_DISCORD=
DISCORD_LOG_WEBHOOK_VOICE=
DISCORD_LOG_WEBHOOK_MAIL=
DISCORD_LOG_WEBHOOK_HEARTBEAT=
# The log channels themselves MUST be excluded from Baxter's message listener,
# else the mirror self-loops (a log post triggers a run, whose logs ship back as a
# new post, ...). Comma-separated channel ids of the #baxter-logs-* channels; every
# OTHER channel (and its webhooks) still triggers normally. Find a log channel's id
# by GETting its webhook URL (returns "channel_id"), or right-click the channel ->
# Copy Channel ID (Developer Mode on).
DISCORD_LOG_EXCLUDE_CHANNELS=
# Fallback webhook used when DISCORD_LOG_SURFACE is unset (the foreground
# `make mail` / `make discord` runs, which aren't compose services). Optional.
DISCORD_LOG_WEBHOOK=

# --- Voice ("Fast Baxter", opt-in; `make voice`) ---
# The voice bot (scripts/voice-bot.ts) auto-joins ONE voice channel whenever a
# human is in it and speaks via Piper TTS. It self-disables unless this is set to
# a voice channel id, AND the GuildVoiceStates intent is enabled in the Developer
# Portal (non-privileged -- just tick it). Experimental; not in the default fleet.
# DISCORD_VOICE_CHANNEL_ID=
# What he says when he joins (phase 1). Later phases add listening + dispatch.
# VOICE_GREETING=Baxter here, what's up?
# Which Piper voice. Baked into the image: en_US-lessac-medium (default, neutral),
# en_US-amy-medium (US female), en_US-ryan-medium (US male). Any other name is
# ignored (falls back to the default) unless you also bake it in the Dockerfile.
# VOICE_NAME=en_US-lessac-medium
# Speaking pace (Piper --length_scale): >1 slower, <1 faster; empty = model default.
# VOICE_LENGTH_SCALE=1.0
# Safety cap on characters synthesized per utterance (later phases feed model text).
# VOICE_MAX_SPEECH_CHARS=600
# Ears (phase 2): transcribe what people say via whisper.cpp. On by default when the
# voice bot runs; VOICE_LISTEN=0 = greeting-only (phase 1). VOICE_SILENCE_MS is the
# end-of-utterance gap (ms) that closes a speaker's audio and triggers transcription.
# VOICE_LISTEN=1
# VOICE_SILENCE_MS=1000
# STT model. Only small.en is baked into the image (accurate, ~3.8s/utterance on CPU) --
# baking every size made the build slow. To use a faster/smaller model, add it to the
# whisper builder loop in app/Dockerfile, rebuild, and point WHISPER_MODEL at it. Path form:
# WHISPER_MODEL=/opt/whisper/models/ggml-small.en.bin
# Hard cap on one capture (ms): force-ends a never-silent source (music bot / stuck mic).
# VOICE_MAX_UTTERANCE_MS=60000
# Fast brain (phase 3): a single OpenRouter call decides answer-aloud vs dispatch to
# the full agent. Needs OPENROUTER_API_KEY (above); no key = ears-only (transcribe +
# log, no responses). This is the LATENCY-CRITICAL path -- pick a fast tool-calling
# model. Benchmarked: google/gemini-2.5-flash ~600ms (recommended) < gpt-4o-mini
# ~830ms. Defaults to OPENROUTER_MODEL if unset.
# VOICE_BRAIN_MODEL=google/gemini-2.5-flash
# VOICE_BRAIN_CONTEXT_TURNS=8
# Read-only shared memory (memory.md) injected into the brain. DEFAULT OFF (0) -- it
# adds latency to the hot brain call for little gain (deep recall dispatches to the
# full agent, which has the real memory). Set a char budget to re-enable.
# VOICE_MEMORY_MAX_CHARS=0
# Where a dispatched task's result is posted. Defaults to the voice channel's own
# integrated text chat (its id doubles as a text channel); set a real text channel
# id if you'd rather results land elsewhere.
# DISCORD_VOICE_TEXT_CHANNEL_ID=
# Muzak: soft hold music played in the voice channel WHILE a dispatched task runs,
# ducked (paused) whenever Baxter speaks, stopped when the work is done. ON by
# default; set VOICE_MUZAK=0 to disable. A track is picked at random each time music
# plays from VOICE_MUZAK_DIR (the baked public-domain collection, ~30 tracks; falls
# back to a synth loop if empty). Set VOICE_MUZAK_FILE to pin ONE file instead, or
# point VOICE_MUZAK_DIR at your own folder (e.g. on the config volume).
# VOICE_MUZAK_VOLUME is a 0..1 inline volume (low = a subtle bed).
# VOICE_MUZAK=1
# VOICE_MUZAK_DIR=/opt/muzak/tracks
# VOICE_MUZAK_FILE=
# VOICE_MUZAK_VOLUME=0.15
# "Fake mute": while YOUR OWN dispatched request is running (music playing), Baxter
# IGNORES your further speech instead of touching your mic -- so you're not re-triggering
# or interrupting him; he resumes for you once your task settles. SPEAKER-scoped: other
# people in the channel stay interactive while your task runs. ON by default; set 0 to
# keep processing all speech mid-work. (Chosen over a real server-mute, which the muted
# user can't self-undo.)
# VOICE_IGNORE_WHILE_WORKING=1
# When a voice-dispatched task finishes, DM the full result to the person who asked, in
# ADDITION to posting it in the text channel. ON by default; set 0 to only post in-channel.
# (Best-effort: a DM to someone who has bot DMs off just fails; the channel post stands.)
# VOICE_DM_RESULT=1

# --- Stealth browser (invisible-cli) ---
# Self-recovery from a hung browser command. If a command hangs (a page that
# never settles, or a wedged Firefox launch), the CLI gives up, SIGKILLs the
# stuck daemon + its browser process group, and for `open` reopens fresh and
# retries once -- instead of blocking until the outer harness timeout (~120s).
# INVISIBLE_CLI_CMD_TIMEOUT=30      # per-command reply timeout; the daemon caps a whole
#                                   #   dispatch 5s under this (derived at daemon spawn), and
#                                   #   each single op at the 20s knobs below
# INVISIBLE_ACTION_TIMEOUT_MS=20000 # per nav/action (goto/click/fill/...) timeout, daemon-side
# INVISIBLE_SNAPSHOT_TIMEOUT_MS=20000 # per snapshot timeout, daemon-side
# INVISIBLE_CLI_CONNECT_TIMEOUT=30  # wait for a freshly-spawned daemon's socket; a
#                                   #   wedged LAUNCH hangs here (~10-20s is healthy)
# INVISIBLE_CLI_BUDGET=110          # total wall-clock cap for one invocation incl.
#                                   #   recovery; keep it under the harness CLI timeout
#                                   #   (OPENROUTER/OPENAI_CLI_TIMEOUT_MS, 120s) so our
#                                   #   own cleanup + error always run

# --- Code execution sandbox (codapi) ---
# Where the app reaches the codapi service (see `make codapi`). The default
# works on the shared docker network; override only if you relocate the service.
# CODAPI_URL=http://codapi:1313
# The enforced per-run limits (offline, memory, pids, timeout) live in
# app/codapi/codapi.json -- edit there and re-run `make codapi` to change them
# (they're baked into the codapi server image, not read from this file).

# --- Web search (SearXNG, backs `web-cli search`) ---
# Where web-cli reaches the SearXNG JSON API. The default works on the shared
# docker network, where `make run` starts a per-fleet searxng by default. To share
# ONE instance across a multi-tenant box (searxng is stateless -> safe to share),
# point this at it and set the Makefile's SEARXNG_LOCAL=0 so no redundant per-tenant
# container starts (that knob is make-level, not a container var -- see the Makefile).
# SEARXNG_URL=http://searxng:8080
# How many results web-cli prints per search.
# SEARXNG_MAX_RESULTS=20

# --- Content moderation (OpenAI /v1/moderations classifier; OFF by default) ---
# One call to OpenAI's dedicated moderation endpoint per message IN (Discord + email) and
# OUT (Baxter's replies) -- FREE, fast (~100-300ms), timeout-resistant. Classified off the
# per-category scores against family-lenient thresholds (NOT the endpoint's stricter `flagged`).
# Blocked inbound gets a friendly canned reply by category; a blocked outbound is refused and
# Baxter apologizes instead. FAIL-OPEN: an endpoint error/timeout (or a missing key) allows the
# message and logs a loud alert -- a family tool shouldn't go silent when the checker is down.
# MODERATION_ENABLED=1                 # master switch (unset/anything-but-1 = off)
# MODERATION_INBOUND=0                 # optional: turn OFF just the inbound direction
# MODERATION_OUTBOUND=0                # optional: turn OFF just the outbound direction
# MODERATION_OPENAI_API_KEY=sk-...     # REQUIRED when enabled: an OpenAI key (moderation is free, but it's an OpenAI endpoint)
# MODERATION_OPENAI_MODEL=omni-moderation-latest   # default; omni also classifies images (text-only here)
# MODERATION_OPENAI_BASE_URL=https://api.openai.com/v1   # default (override only for a proxy)
# MODERATION_HARD_THRESHOLD=0.5        # clearly-unsafe categories (sexual/minors, hate/threatening, ...) block on a weak signal
# MODERATION_SOFT_THRESHOLD=0.85       # everything else needs a strong signal (family-lenient; avoids false positives)
# MODERATION_TIMEOUT_MS=4000           # per-call timeout; on timeout the message is allowed (fail-open)

# --- Calendar (calendar-cli) ---
# The family's shared read-only calendar feed(s) that `calendar-cli poll` fetches --
# a Google "Secret address in iCal format", an iCloud public calendar link, or any
# ICS URL. Comma-separated for multiple (e.g. both parents). Empty => poll is a no-op.
# CALENDAR_FEED_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# Publishing Baxter's OWN feed needs an object-storage credential in
# ~/.mail-agent/calendar-keys.json (0600, NOT here -- it's a secret file, like
# data-keys.json): { "endpoint": "https://<acct>.r2.cloudflarestorage.com", "bucket":
# "...", "region": "auto", "accessKeyId": "...", "secretAccessKey": "...", "objectKey":
# "<random-token>.ics" }. The family subscribes to webcal://<your-cal-domain>/<token>.ics.
# NOTE: "region": "auto" is Cloudflare R2 only -- Backblaze B2 and AWS S3 need the
# bucket's REAL region in the SigV4 credential scope, or the PUT fails SignatureDoesNotMatch.

# --- SMS (Sendblue; opt-in, needs `sms` in BAXTER_SURFACES) ---
# Lets a family member text Baxter and get a reply. Requires the `sms` compose
# profile/surface (add `sms` to BAXTER_SURFACES) AND `home-keys.json`
# (provisioned by `baxctl home <id>`, same as the `home` surface -- sms rides the
# same control-plane link handshake). See docs/architecture/home.md's "SMS
# surface" section for the full path.
#
# Sendblue is a FLEET-WIDE shared account on the free tier (one shared number for
# every tenant) -- these three are CONTAINER-side env vars, the same values on
# every tenant's `sms` service, not a per-tenant credential. The daemon
# (sms-bot.ts) holds them, writes them 0600 for sms-cli, and strips them from the
# spawned run's env -- the agent only ever sends through `sms-cli`.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# The shared Sendblue number outbound replies are sent from (E.164).
SENDBLUE_FROM_NUMBER=
# Optional daily send cap (flood guard), analogous to MAX_SENDS_PER_DAY /
# DISCORD_MAX_SENDS_PER_DAY. Unset = default of 500. 0 = KILL SWITCH (refuses
# every send, i.e. an emergency "SMS off" without unwiring the surface).
# SMS_MAX_SENDS_PER_DAY=500
#
# NOT a container var -- do NOT set it here: SMS_WEBHOOK_SECRET (the path
# segment in POST /sms/inbound/<secret>) is a Cloudflare WORKER secret, set on
# workers/home with `wrangler secret put SMS_WEBHOOK_SECRET`. It authenticates
# the inbound webhook and never reaches the container.

# --- Heartbeat scheduler (make heartbeat) ---
# Driver tick interval (how often it scans for due tasks).
HEARTBEAT_INTERVAL_SECONDS=60
# Invisibility window: a claimed task won't be re-fired for this long (protects
# a slow/crashed run from double-firing).
HEARTBEAT_VISIBILITY_MINUTES=15
# Failed fires retried after the window; after this many the fire gives up (a
# one-shot is dropped; a cron reschedules to its next occurrence, attempts reset).
HEARTBEAT_MAX_ATTEMPTS=3
# Enforced guardrails (fail closed on a bad value): min gap between a recurring
# task's fires; max tasks in the schedule; max total fires per UTC day.
HEARTBEAT_MIN_INTERVAL_MINUTES=60
HEARTBEAT_MAX_TASKS=100
HEARTBEAT_MAX_FIRES_PER_DAY=200
# Fallback timezone for a task with no --tz (Baxter usually sets the requester's).
# Also the timezone the openrouter/local runners show the model as the current
# local time (see BAXTER_TZ to override just that).
HEARTBEAT_TZ=America/Los_Angeles
# Timezone shown as "now" in the openrouter/local system preamble (every run gets
# the current date/time injected, since these harnesses -- unlike Claude Code --
# don't otherwise tell the model the date). Defaults to HEARTBEAT_TZ, then Pacific.
#BAXTER_TZ=America/Los_Angeles
